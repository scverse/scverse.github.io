{
    "customSyntax": "postcss-scss",
    "rules": {
        "color-no-hex": true,
        "color-named": "never",
        "function-disallowed-list": [
            "rgb",
            "rgba",
            "hsl",
            "hsla",
            "hwb",
            "lab",
            "lch",
            "oklab",
            "oklch"
        ],
        "media-feature-name-disallowed-list": [
            ["width", "min-width", "max-width"],
            {
                "message": "Use the breakpoint mixins from lib/_breakpoints.scss"
            }
        ]
    }
}
